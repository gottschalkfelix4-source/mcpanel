# ---------------------------------------------------------------------------
# MCPanel – Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an.
# ---------------------------------------------------------------------------

# Öffentlicher Port des Web-Panels
PANEL_PORT=8080

# Absoluter Pfad auf dem HOST, unter dem alle Serverdaten liegen.
# Wichtig: muss ein echter Host-Pfad sein, weil die Minecraft-Container
# ihn per Bind-Mount bekommen.
#   Linux/macOS: /srv/mcpanel
#   Windows:     C:/mcpanel   (Docker Desktop)
HOST_DATA_ROOT=./data

# Port-Bereich, aus dem neue Minecraft-Server ihren Port bekommen
MC_PORT_MIN=25565
MC_PORT_MAX=25700

# Hostname/IP, die den Nutzern als Server-Adresse angezeigt wird
PUBLIC_HOST=localhost

# Secret für die Session-Tokens – UNBEDINGT ändern!
JWT_SECRET=bitte-hier-ein-langes-zufaelliges-secret-eintragen

# Erster Admin-Account, wird beim ersten Start angelegt
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# CurseForge API-Key (https://console.curseforge.com/ -> API Keys).
# Ohne Key funktioniert nur Modrinth.
CURSEFORGE_API_KEY=

# Datenbank
POSTGRES_USER=mcpanel
POSTGRES_PASSWORD=mcpanel
POSTGRES_DB=mcpanel

# Namensserver fuer die Minecraft-Container, kommagetrennt.
# Leer lassen = Resolver des Docker-Hosts. Eintragen, wenn dort ein filternder
# DNS laeuft (Pi-hole, AdGuard) und Downloads von Mojang haengenbleiben.
# Beispiel: 1.1.1.1,9.9.9.9
MC_DNS=
