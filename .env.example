# ---------------------------------------------------------------------------
# MCPanel – Konfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an.
# ---------------------------------------------------------------------------

# Öffentlicher Port des Web-Panels
PANEL_PORT=8080

# Absoluter Pfad auf dem HOST, unter dem alle Serverdaten liegen.
# Wichtig: muss ein echter Host-Pfad sein, weil die Minecraft-Container
# ihn per Bind-Mount bekommen.
#   Linux/macOS: /srv/mcpanel
#   Windows:     C:/mcpanel   (Docker Desktop)
HOST_DATA_ROOT=

# Port-Bereich, aus dem neue Minecraft-Server ihren Port bekommen
MC_PORT_MIN=25565
MC_PORT_MAX=25700

# Hostname/IP, die den Nutzern als Server-Adresse angezeigt wird
PUBLIC_HOST=localhost

# Secret für die Session-Tokens.
# Leer lassen ist der Normalfall: das Panel erzeugt beim ersten Start selbst
# eines und legt es unter /data/.jwt-secret ab. Nur eintragen, wenn mehrere
# Instanzen dasselbe Geheimnis brauchen – und dann einen langen Zufallswert,
# niemals einen abgeschriebenen Beispielwert.
JWT_SECRET=

# Erster Admin-Account, nur für einen unbeaufsichtigten Start.
# Leer lassen ist der Normalfall: das Panel führt beim ersten Aufruf im Browser
# durch die Einrichtung und fragt dort nach Konto und Passwort. Wer hier etwas
# einträgt, braucht alle drei Werte; ein offensichtlicher Platzhalter als
# Passwort wird abgelehnt.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CurseForge API-Key (https://console.curseforge.com/ -> API Keys).
# Ohne Key funktioniert nur Modrinth.
CURSEFORGE_API_KEY=

# Datenbank. Der Container ist nur im internen Compose-Netz erreichbar, deshalb
# genügt die Vorgabe im Normalfall. Wer den Port nach außen öffnet oder die
# Datenbank mit anderen Diensten teilt, setzt hier ein eigenes Passwort – und
# zwar vor dem ersten Start, danach steht es bereits im Datenbank-Volume.
POSTGRES_USER=mcpanel
POSTGRES_PASSWORD=mcpanel
POSTGRES_DB=mcpanel

# Namensserver fuer die Minecraft-Container, kommagetrennt.
# Leer lassen = Resolver des Docker-Hosts. Eintragen, wenn dort ein filternder
# DNS laeuft (Pi-hole, AdGuard) und Downloads von Mojang haengenbleiben.
# Beispiel: 1.1.1.1,9.9.9.9
MC_DNS=
