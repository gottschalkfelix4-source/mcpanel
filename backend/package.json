    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.20.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "dockerode": "^4.0.2",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.0",
    "tar": "^7.4.3",
    "zod": "^3.23.8",
    "prisma": "^5.20.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
